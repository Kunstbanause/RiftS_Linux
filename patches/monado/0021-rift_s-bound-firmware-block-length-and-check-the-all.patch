From 9494865b306bd6c302c8e829dd7fc3e432cfc386 Mon Sep 17 00:00:00 2001
From: lbgos <285507185+lbgos@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:58:08 +0300
Subject: [PATCH 21/46] rift_s: bound firmware block length and check the
 allocation

block_len comes from the device. Cap it at 1 MiB and handle malloc
failure instead of NULL-dereferencing or truncating len_out.

(cherry picked from commit 9c2d0252e387c266e4fc102c86902d9c2ba6654a)
---
 src/xrt/drivers/rift_s/rift_s_protocol.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/xrt/drivers/rift_s/rift_s_protocol.c b/src/xrt/drivers/rift_s/rift_s_protocol.c
index dabde2f..36c996a 100644
--- a/src/xrt/drivers/rift_s/rift_s_protocol.c
+++ b/src/xrt/drivers/rift_s/rift_s_protocol.c
@@ -186,6 +186,9 @@ rift_s_hexdump_buffer(const char *label, const unsigned char *buf, int length)
 	RIFT_S_DEBUG("%s", outbuf);
 }
 
+/* Firmware JSON blocks are tens of KB at most; the length field is device-controlled. */
+#define RIFT_S_MAX_FW_BLOCK_LEN (1u << 20)
+
 static int
 get_feature_report(struct os_hid_device *hid, uint8_t cmd, uint8_t *buf, int len)
 {
@@ -263,7 +266,7 @@ rift_s_read_firmware_block(struct os_hid_device *dev, uint8_t block_id, char **d
 	/* The block header is 12 bytes. 8 byte checksum, 4 byte size? */
 	block_len = *(uint32_t *)(buf + 16);
 
-	if (block_len < 0xC || block_len == 0xFFFFFFFF)
+	if (block_len < 0xC || block_len == 0xFFFFFFFF || block_len > RIFT_S_MAX_FW_BLOCK_LEN)
 		return -1; /* Invalid block */
 
 #if 0
@@ -273,6 +276,8 @@ rift_s_read_firmware_block(struct os_hid_device *dev, uint8_t block_id, char **d
 
 	/* Copy the contents of the fw block, minus the header */
 	outbuf = malloc(block_len + 1);
+	if (outbuf == NULL)
+		return -1;
 	outbuf[block_len] = 0;
 	total_read = 0x0;
 
-- 
2.56.0

