+/*
+ * Camera passthrough, a pseudo layer filled in by the compositor (not by apps):
+ * - transform:   camera from view (camera space: OpenCV, +z forward, +y down)
+ * - mv_inverse:  Fisheye62 intrinsics, columns [fx fy cx cy] [k1 k2 k3 k4] [k5 k6 p1 p2]
+ *                [sphere radius, 1/width, 1/height, unused]
+ *
+ * Every view ray hits a sphere around the eye at the given radius, that point is projected into the camera.
+ */
+vec4 do_passthrough(vec2 view_uv, uint layer)
+{
+	uint source_image_index = LAYER.image_info.color_image_index;
+	vec4 proj = LAYER.mv_inverse[0];
+	vec4 ka = LAYER.mv_inverse[1];
+	vec4 kb = LAYER.mv_inverse[2];
+	vec4 misc = LAYER.mv_inverse[3];
+
+	vec3 dir = get_direction(view_uv);
+	vec3 p = (LAYER.transform * vec4(dir * misc.x, 1.0)).xyz;
+
+	// Fisheye62, the same model as the Rift S firmware calibration
+	float r = length(p.xy);
+	float theta = atan(r, p.z);
+	if (theta > 1.65) {
+		// Behind the lens' field of view
+		return vec4(0, 0, 0, 1);
+	}
+
+	vec2 xp = r > 1e-8 ? p.xy * (theta / r) : vec2(0.0);
+	float t2 = theta * theta;
+	float r_theta =
+	    1.0 + t2 * (ka.x + t2 * (ka.y + t2 * (ka.z + t2 * (ka.w + t2 * (kb.x + t2 * kb.y)))));
+	float p1 = kb.z;
+	float p2 = kb.w;
+	vec2 delta = vec2(2.0 * p1 * xp.x * xp.y + p2 * (t2 + 2.0 * xp.x * xp.x),
+	                  2.0 * p2 * xp.x * xp.y + p1 * (t2 + 2.0 * xp.y * xp.y));
+	vec2 m = xp * r_theta + delta;
+
+	// Pixel centres are at integer coordinates
+	vec2 pixel = vec2(proj.x * m.x + proj.z, proj.y * m.y + proj.w);
+	vec2 uv = (pixel + 0.5) * misc.yz;
+	if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
+		return vec4(0, 0, 0, 1);
+	}
+
+	// The camera values look right shown as they are, so treat them as sRGB encoded
+	float v = texture(source[source_image_index], uv).r;
+	float lin = v <= 0.04045 ? v / 12.92 : pow((v + 0.055) / 1.055, 2.4);
+
+	return vec4(lin, lin, lin, 1.0);
+}
