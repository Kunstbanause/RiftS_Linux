From 4c92a9c4fffb77ee8f5245b30571c6329b8f0486 Mon Sep 17 00:00:00 2001
From: lbgos <285507185+lbgos@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:58:12 +0300
Subject: [PATCH 22/46] rift_s: validate radio reply length before copying JSON
 bytes

reply_len is device-controlled; without checking it against the
actual response size the memcpy over-reads the stack response.

(cherry picked from commit 8b88a136cf082bf88901bcea1909a62e7071aa91)
---
 src/xrt/drivers/rift_s/rift_s_radio.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/xrt/drivers/rift_s/rift_s_radio.c b/src/xrt/drivers/rift_s/rift_s_radio.c
index 973711b..b4cfb81 100644
--- a/src/xrt/drivers/rift_s/rift_s_radio.c
+++ b/src/xrt/drivers/rift_s/rift_s_radio.c
@@ -249,6 +249,11 @@ read_json_cb(bool success, uint8_t *response_bytes, int response_bytes_len, rift
 	}
 
 	uint8_t reply_len = response_bytes[4];
+	if (reply_len > response_bytes_len - 5) {
+		RIFT_S_WARN("Radio response claims %u bytes but carried %d\n", reply_len,
+		            response_bytes_len - 5);
+		goto fail;
+	}
 	response_bytes += 5;
 
 	if (json_read->cur_offset == 0) {
-- 
