+//! Copies an L8 frame (usually a region of the camera's frame) into a tightly packed frame of its own
+static struct xrt_frame *
+copy_frame_l8(struct xrt_frame *src)
+{
+	struct xrt_frame *dst = NULL;
+	u_frame_create_one_off(XRT_FORMAT_L8, src->width, src->height, &dst);
+	for (uint32_t y = 0; y < src->height; y++) {
+		memcpy(dst->data + y * dst->stride, src->data + y * src->stride, src->width);
+	}
+	dst->timestamp = src->timestamp;
+	return dst;
+}
+
+//! Keep the latest front camera images while the compositor asks for them
+static void
+rift_s_tracker_update_passthrough(struct rift_s_tracker *t,
+                                  timepoint_ns frame_mono_ns,
+                                  struct xrt_frame *frames[RIFT_S_CAMERA_COUNT])
+{
+	os_mutex_lock(&t->passthrough.mutex);
+	bool wanted = (os_monotonic_get_ns() - t->passthrough.last_request_ns) < PASSTHROUGH_REQUEST_TIMEOUT_NS;
+	os_mutex_unlock(&t->passthrough.mutex);
+
+	struct xrt_frame *copies[XRT_MAX_PASSTHROUGH_CAMERAS] = {0};
+	if (wanted) {
+		for (int i = 0; i < XRT_MAX_PASSTHROUGH_CAMERAS; i++) {
+			if (frames[i] == NULL || frames[i]->format != XRT_FORMAT_L8) {
+				return;
+			}
+		}
+		// Copy outside the lock, the compositor polls every frame
+		for (int i = 0; i < XRT_MAX_PASSTHROUGH_CAMERAS; i++) {
+			copies[i] = copy_frame_l8(frames[i]);
+		}
+	}
+
+	// Swap in the new images (or drop the old ones when nobody wants them), release outside the lock
+	os_mutex_lock(&t->passthrough.mutex);
+	for (int i = 0; i < XRT_MAX_PASSTHROUGH_CAMERAS; i++) {
+		struct xrt_frame *old = t->passthrough.frames[i];
+		t->passthrough.frames[i] = copies[i];
+		copies[i] = old;
+	}
+	t->passthrough.timestamp_ns = wanted ? frame_mono_ns : 0;
+	os_mutex_unlock(&t->passthrough.mutex);
+
+	for (int i = 0; i < XRT_MAX_PASSTHROUGH_CAMERAS; i++) {
+		xrt_frame_reference(&copies[i], NULL);
+	}
+}
+
+void
+rift_s_tracker_get_passthrough_frames(struct rift_s_tracker *t, bool want_images, struct xrt_passthrough_frames *out)
+{
+	U_ZERO(out);
+	timepoint_ns now = os_monotonic_get_ns();
+
+	os_mutex_lock(&t->passthrough.mutex);
+	out->forced = t->passthrough.forced;
+
+	if (want_images) {
+		t->passthrough.last_request_ns = now;
+
+		// Old images mean the camera stream stopped, show nothing rather than a frozen room
+		bool fresh = t->passthrough.timestamp_ns != 0 &&
+		             (now - t->passthrough.timestamp_ns) < PASSTHROUGH_MAX_FRAME_AGE_NS;
+		if (fresh && t->passthrough.frames[0] != NULL && t->passthrough.frames[1] != NULL) {
+			for (int i = 0; i < XRT_MAX_PASSTHROUGH_CAMERAS; i++) {
+				out->cameras[i] = t->passthrough.cams[i];
+				out->cameras[i].frame = NULL;
+				xrt_frame_reference(&out->cameras[i].frame, t->passthrough.frames[i]);
+				out->cameras[i].timestamp_ns = t->passthrough.timestamp_ns;
+			}
+			out->camera_count = XRT_MAX_PASSTHROUGH_CAMERAS;
+		}
+	}
+	os_mutex_unlock(&t->passthrough.mutex);
+}
+
+void
+rift_s_tracker_toggle_passthrough(struct rift_s_tracker *t)
+{
+	os_mutex_lock(&t->passthrough.mutex);
+	t->passthrough.forced = !t->passthrough.forced;
+	bool forced = t->passthrough.forced;
+	os_mutex_unlock(&t->passthrough.mutex);
+
+	RIFT_S_INFO("Passthrough %s", forced ? "on" : "off");
+}
+
+void
+rift_s_tracker_get_passthrough_status(struct rift_s_tracker *t,
+                                      timepoint_ns now,
+                                      bool *out_forced,
+                                      bool *out_streaming,
+                                      double *out_frame_age_ms)
+{
+	os_mutex_lock(&t->passthrough.mutex);
+	*out_forced = t->passthrough.forced;
+	*out_streaming = (now - t->passthrough.last_request_ns) < PASSTHROUGH_REQUEST_TIMEOUT_NS;
+	*out_frame_age_ms = t->passthrough.timestamp_ns != 0
+	                        ? (double)(now - t->passthrough.timestamp_ns) / U_TIME_1MS_IN_NS
+	                        : -1.0;
+	os_mutex_unlock(&t->passthrough.mutex);
+}
+
 void
 rift_s_tracker_push_slam_frames(struct rift_s_tracker *t,
                                 uint64_t frame_ts_ns,
@@ -713,6 +864,8 @@ rift_s_tracker_push_slam_frames(struct rift_s_tracker *t,
 			xrt_sink_push_frame(t->slam_sinks.cams[i], frames[i]);
 		}
 	}
+
+	rift_s_tracker_update_passthrough(t, frame_mono_ns, frames);
 }
 
