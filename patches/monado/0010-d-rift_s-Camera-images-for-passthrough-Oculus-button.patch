+//! Front camera poses and intrinsics for passthrough, view i uses SLAM camera i (front left, front right)
+static void
+rift_s_fill_passthrough_calibration(struct rift_s_tracker *t, struct rift_s_hmd_config *hmd_config)
+{
+	for (int i = 0; i < XRT_MAX_PASSTHROUGH_CAMERAS; i++) {
+		struct rift_s_camera_calibration *cam = &hmd_config->camera_calibration.cameras[CAM_IDX_TO_ID[i]];
+		struct xrt_passthrough_camera *out = &t->passthrough.cams[i];
+
+		// The head pose is the device pose, and the firmware camera frame is already OpenCV style
+		math_pose_from_isometry(&cam->device_from_camera, &out->head_from_camera);
+
+		out->fx = cam->projection.fx;
+		out->fy = cam->projection.fy;
+		out->cx = cam->projection.cx;
+		out->cy = cam->projection.cy;
+		for (int k = 0; k < 6; k++) {
+			out->k[k] = cam->distortion.k[k];
+		}
+		out->p1 = cam->distortion.p1;
+		out->p2 = cam->distortion.p2;
+	}
+}
