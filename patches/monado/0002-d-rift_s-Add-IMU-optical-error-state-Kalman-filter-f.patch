+TEST_CASE("rift_s_ctrl_fusion: gross outlier fix is rejected")
+{
+	Sim sim;
+	for (int64_t t = kImuPeriod; t < 3000 * kMs; t += kImuPeriod) {
+		sim.tick(t);
+	}
+	const int64_t now = 3000 * kMs;
+	Vector3d before = sim.fused_pos(now - 10 * kMs);
+
+	xrt_pose bad = sim.optical_pose(now - 10 * kMs);
+	bad.position.x += 0.5f;
+	CHECK(rift_s_ctrl_fusion_pose(sim.fusion, now - 10 * kMs, &bad) == RIFT_S_CTRL_FUSION_POSE_REJECTED);
+
+	Vector3d after = sim.fused_pos(now - 10 * kMs);
+	CHECK((after - before).norm() < 1e-6);
+}
+
+TEST_CASE("rift_s_ctrl_fusion: repeated far fixes reset the filter")
+{
+	Sim sim;
+	for (int64_t t = kImuPeriod; t < 3000 * kMs; t += kImuPeriod) {
+		sim.tick(t);
+	}
+	int64_t t = 3000 * kMs;
+	Vector3d jump(0.6, 0, 0);
+	rift_s_ctrl_fusion_pose_result last = RIFT_S_CTRL_FUSION_POSE_ACCEPTED;
+	for (int i = 0; i < 6 && last != RIFT_S_CTRL_FUSION_POSE_RESET; i++) {
+		xrt_pose p = sim.optical_pose(t);
+		p.position.x += (float)jump.x();
+		last = rift_s_ctrl_fusion_pose(sim.fusion, t, &p);
+		for (int k = 0; k < 16; k++) {
+			t += kImuPeriod;
+			sim.feed_imu(t);
+		}
+	}
+	CHECK(last == RIFT_S_CTRL_FUSION_POSE_RESET);
+	rift_s_ctrl_fusion_stats stats;
+	rift_s_ctrl_fusion_get_stats(sim.fusion, &stats);
+	CHECK(stats.resets >= 2);
+}
