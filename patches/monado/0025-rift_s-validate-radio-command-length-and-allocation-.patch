From 9ea4067495a71efc5a6f3f83d89716aeb03c6896 Mon Sep 17 00:00:00 2001
From: lbgos <285507185+lbgos@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:58:28 +0300
Subject: [PATCH 25/46] rift_s: validate radio command length and allocation at
 runtime

The queue length check was assert-only, so release builds would
overflow cmd_bytes on a bad caller. Reject bad lengths and OOM.

(cherry picked from commit 3030d7d3a5c46f124deb2db2bcb500265e18704d)
---
 src/xrt/drivers/rift_s/rift_s_radio.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/xrt/drivers/rift_s/rift_s_radio.c b/src/xrt/drivers/rift_s/rift_s_radio.c
index be16901..3203090 100644
--- a/src/xrt/drivers/rift_s/rift_s_radio.c
+++ b/src/xrt/drivers/rift_s/rift_s_radio.c
@@ -181,8 +181,13 @@ queue_report(rift_s_radio_state *state,
              void *cb_data)
 {
 	rift_s_radio_command *cmd = U_TYPED_CALLOC(rift_s_radio_command);
+	if (cmd == NULL)
+		return;
 
-	assert(cmd_bytes_len <= (int)sizeof(cmd->read_command.cmd_bytes));
+	if (cmd_bytes_len < 0 || cmd_bytes_len > (int)sizeof(cmd->read_command.cmd_bytes)) {
+		free(cmd);
+		return;
+	}
 
 	cmd->read_command.cmd = report_id;
 	cmd->read_command.device_id = device_id;
-- 
