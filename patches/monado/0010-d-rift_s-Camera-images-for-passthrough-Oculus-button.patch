+//! Long press on the Oculus button toggles passthrough. Short presses still go to apps as usual.
+static void
+check_passthrough_long_press(struct rift_s_controller *ctrl, timepoint_ns local_ts)
+{
+	int64_t hold_ms = debug_get_num_option_rift_s_passthrough_hold_ms();
+	if (ctrl->device_type != RIFT_S_DEVICE_RIGHT_CONTROLLER || hold_ms <= 0) {
+		return;
+	}
+
+	if (!(ctrl->buttons & RIFT_S_BUTTON_MENU_OCULUS)) {
+		ctrl->oculus_press_start_ns = 0;
+		return;
+	}
+
+	if (ctrl->oculus_press_start_ns == 0) {
+		ctrl->oculus_press_start_ns = local_ts;
+		ctrl->oculus_long_press_handled = false;
+		return;
+	}
+
+	if (!ctrl->oculus_long_press_handled && (local_ts - ctrl->oculus_press_start_ns) >= hold_ms * U_TIME_1MS_IN_NS) {
+		ctrl->oculus_long_press_handled = true;
+		rift_s_tracker_toggle_passthrough(rift_s_system_get_tracker(ctrl->sys));
+	}
+}
