diff --git a/tests/tests_rift_s_controller_fusion.cpp b/tests/tests_rift_s_controller_fusion.cpp
new file mode 100644
index 0000000..575c17f
--- /dev/null
+++ b/tests/tests_rift_s_controller_fusion.cpp
@@ -0,0 +1,453 @@
+// Copyright 2026, Kunstbanause
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief Synthetic-trajectory tests for the Rift S controller IMU + optical fusion.
+ */
+
+#include "drivers/rift_s/rift_s_controller_fusion.h"
+
+#include "catch_amalgamated.hpp"
+
+#include <Eigen/Core>
+#include <Eigen/Geometry>
+
+#include <cmath>
+#include <deque>
+#include <random>
+#include <vector>
+
+using Eigen::Quaterniond;
+using Eigen::Vector3d;
+
+namespace {
+
+constexpr double kGravity = 9.80665;
+constexpr int64_t kMs = 1000 * 1000;
+constexpr int64_t kImuPeriod = 2 * kMs;    // 500 Hz
+constexpr int64_t kFixPeriod = 33 * kMs;   // ~30 Hz
+constexpr int64_t kFixDelay = 25 * kMs;    // exposure -> pose available
+constexpr double kOpticalPosSigma = 0.003; // m
+constexpr double kOpticalRotSigma = 0.015; // rad
+
+double
+s_of(int64_t ns)
+{
+	return (double)ns / 1e9;
+}
+
+//! Ground-truth controller motion: per-axis sinusoids, rotation about a fixed tilted axis.
+struct Trajectory
+{
+	Vector3d center{0.2, 1.1, -0.4};
+	Vector3d amp{0.15, 0.10, 0.12};
+	Vector3d freq{0.9, 1.3, 0.7}; // Hz
+	Vector3d axis = Vector3d(0.3, 1.0, 0.2).normalized();
+	double rot_amp = 0.8;  // rad
+	double rot_freq = 0.6; // Hz
+	bool moving = true;
+
+	Vector3d
+	pos(double t) const
+	{
+		if (!moving) {
+			return center;
+		}
+		Vector3d p;
+		for (int i = 0; i < 3; i++) {
+			p[i] = center[i] + amp[i] * std::sin(2 * M_PI * freq[i] * t);
+		}
+		return p;
+	}
+
+	Vector3d
+	accel(double t) const
+	{
+		if (!moving) {
+			return Vector3d::Zero();
+		}
+		Vector3d a;
+		for (int i = 0; i < 3; i++) {
+			double w = 2 * M_PI * freq[i];
+			a[i] = -amp[i] * w * w * std::sin(w * t);
+		}
+		return a;
+	}
+
+	double
+	angle(double t) const
+	{
+		return moving ? rot_amp * std::sin(2 * M_PI * rot_freq * t) : 0.3;
+	}
+
+	double
+	angle_rate(double t) const
+	{
+		double w = 2 * M_PI * rot_freq;
+		return moving ? rot_amp * w * std::cos(w * t) : 0.0;
+	}
+
+	Quaterniond
+	rot(double t) const
+	{
+		return Quaterniond(Eigen::AngleAxisd(angle(t), axis));
+	}
+};
+
+struct Sim
+{
+	Trajectory traj;
+	std::mt19937 rng{1234};
+	std::normal_distribution<double> unit{0.0, 1.0};
+
+	Vector3d gyro_bias{0.02, -0.015, 0.01};
+	Vector3d accel_bias{0.15, -0.1, 0.2};
+	double gyro_noise = 0.003; // per sample std dev
+	double accel_noise = 0.05; // per sample std dev
+
+	rift_s_ctrl_fusion *fusion = nullptr;
+
+	//! Fixes are delivered this long after exposure; exposures inside [drop_from, drop_to) are lost
+	int64_t drop_from = -1;
+	int64_t drop_to = -1;
+
+	struct PendingFix
+	{
+		int64_t exposure;
+		int64_t deliver;
+		xrt_pose pose;
+	};
+	std::deque<PendingFix> pending;
+
+	//! Last delivered optical position, the "no fusion" baseline
+	bool have_last_fix = false;
+	Vector3d last_fix_pos{0, 0, 0};
+
+	std::vector<rift_s_ctrl_fusion_pose_result> results;
+
+	Sim()
+	{
+		rift_s_ctrl_fusion_params params;
+		rift_s_ctrl_fusion_default_params(&params);
+		fusion = rift_s_ctrl_fusion_create(&params);
+	}
+
+	~Sim()
+	{
+		rift_s_ctrl_fusion_destroy(&fusion);
+	}
+
+	Vector3d
+	noise3(double sigma)
+	{
+		return Vector3d(unit(rng), unit(rng), unit(rng)) * sigma;
+	}
+
+	void
+	feed_imu(int64_t t_ns)
+	{
+		double t = s_of(t_ns);
+		Quaterniond q = traj.rot(t);
+		Vector3d w_body = traj.axis * traj.angle_rate(t); // fixed axis: body rate == world rate
+		Vector3d f_body = q.conjugate() * (traj.accel(t) + Vector3d(0, kGravity, 0));
+
+		Vector3d gyro = w_body + gyro_bias + noise3(gyro_noise);
+		Vector3d accel = f_body + accel_bias + noise3(accel_noise);
+
+		xrt_vec3 g{(float)gyro.x(), (float)gyro.y(), (float)gyro.z()};
+		xrt_vec3 a{(float)accel.x(), (float)accel.y(), (float)accel.z()};
+		rift_s_ctrl_fusion_imu(fusion, t_ns, &g, &a);
+	}
+
+	xrt_pose
+	optical_pose(int64_t t_ns)
+	{
+		double t = s_of(t_ns);
+		Vector3d p = traj.pos(t) + noise3(kOpticalPosSigma);
+		Vector3d dtheta = noise3(kOpticalRotSigma);
+		Quaterniond q = traj.rot(t) * Quaterniond(Eigen::AngleAxisd(dtheta.norm(), dtheta.normalized()));
+		xrt_pose pose;
+		pose.position = {(float)p.x(), (float)p.y(), (float)p.z()};
+		pose.orientation = {(float)q.x(), (float)q.y(), (float)q.z(), (float)q.w()};
+		return pose;
+	}
+
+	void
+	schedule_fix(int64_t exposure_ns)
+	{
+		if (exposure_ns >= drop_from && exposure_ns < drop_to) {
+			return;
+		}
+		pending.push_back({exposure_ns, exposure_ns + kFixDelay, optical_pose(exposure_ns)});
+	}
+
+	void
+	deliver_due(int64_t now_ns)
+	{
+		while (!pending.empty() && pending.front().deliver <= now_ns) {
+			PendingFix f = pending.front();
+			pending.pop_front();
+			results.push_back(rift_s_ctrl_fusion_pose(fusion, f.exposure, &f.pose));
+			have_last_fix = true;
+			last_fix_pos = Vector3d(f.pose.position.x, f.pose.position.y, f.pose.position.z);
+		}
+	}
+
+	//! Advance one IMU tick: feed IMU, schedule fixes on exposure ticks, deliver due fixes.
+	void
+	tick(int64_t now_ns)
+	{
+		feed_imu(now_ns);
+		if (now_ns % kFixPeriod < kImuPeriod) {
+			schedule_fix(now_ns);
+		}
+		deliver_due(now_ns);
+	}
+
+	Vector3d
+	fused_pos(int64_t at_ns, xrt_space_relation *out_rel = nullptr)
+	{
+		xrt_space_relation rel{};
+		bool ok = rift_s_ctrl_fusion_get_relation(fusion, at_ns, &rel);
+		REQUIRE(ok);
+		if (out_rel != nullptr) {
+			*out_rel = rel;
+		}
+		return Vector3d(rel.pose.position.x, rel.pose.position.y, rel.pose.position.z);
+	}
+
+	Quaterniond
+	fused_rot(int64_t at_ns)
+	{
+		xrt_space_relation rel{};
+		REQUIRE(rift_s_ctrl_fusion_get_relation(fusion, at_ns, &rel));
+		return Quaterniond(rel.pose.orientation.w, rel.pose.orientation.x, rel.pose.orientation.y,
+		                   rel.pose.orientation.z);
+	}
+};
+
+struct ErrorStats
+{
+	double sum_sq = 0;
+	double max = 0;
+	int n = 0;
+
+	void
+	add(double e)
+	{
+		sum_sq += e * e;
+		max = std::max(max, e);
+		n++;
+	}
+
+	double
+	rms() const
+	{
+		return n > 0 ? std::sqrt(sum_sq / n) : 0.0;
+	}
+};
+
+constexpr int64_t kWarmup = 2000 * kMs;
+
+} // namespace
+
+TEST_CASE("rift_s_ctrl_fusion: not initialised before an optical fix")
+{
+	Sim sim;
+	for (int64_t t = kImuPeriod; t < 100 * kMs; t += kImuPeriod) {
+		sim.feed_imu(t);
+	}
+	xrt_space_relation rel{};
+	CHECK_FALSE(rift_s_ctrl_fusion_get_relation(sim.fusion, 100 * kMs, &rel));
+	CHECK_FALSE(rift_s_ctrl_fusion_is_initialised(sim.fusion));
+}
+
+TEST_CASE("rift_s_ctrl_fusion: static controller is smoother than raw optical")
+{
+	Sim sim;
+	sim.traj.moving = false;
+	ErrorStats err;
+	for (int64_t t = kImuPeriod; t < 6000 * kMs; t += kImuPeriod) {
+		sim.tick(t);
+		if (t > kWarmup) {
+			err.add((sim.fused_pos(t) - sim.traj.pos(s_of(t))).norm());
+		}
+	}
+	INFO("static rms " << err.rms() << " max " << err.max);
+	// Raw optical noise is 3 mm per axis, ~5.2 mm 3D RMS; require at least 40% smoothing
+	CHECK(err.rms() < 0.6 * std::sqrt(3.0) * kOpticalPosSigma);
+	CHECK(err.max < 0.010);
+}
+
+TEST_CASE("rift_s_ctrl_fusion: moving controller beats the last-fix baseline")
+{
+	Sim sim;
+	ErrorStats fused, baseline, fused_rot;
+	for (int64_t t = kImuPeriod; t < 8000 * kMs; t += kImuPeriod) {
+		sim.tick(t);
+		if (t > kWarmup) {
+			Vector3d truth = sim.traj.pos(s_of(t));
+			fused.add((sim.fused_pos(t) - truth).norm());
+			baseline.add((sim.last_fix_pos - truth).norm());
+			Quaterniond dq = sim.traj.rot(s_of(t)).conjugate() * sim.fused_rot(t);
+			fused_rot.add(2 * std::acos(std::min(1.0, std::fabs(dq.w()))));
+		}
+	}
+	INFO("fused rms " << fused.rms() << " baseline rms " << baseline.rms() << " rot rms " << fused_rot.rms());
+	CHECK(fused.rms() < 0.005);
+	CHECK(fused.rms() < 0.25 * baseline.rms());
+	CHECK(fused_rot.rms() < 0.02);
+}
+
+TEST_CASE("rift_s_ctrl_fusion: forward prediction to display time")
