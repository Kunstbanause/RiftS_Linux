     {XRT_INPUT_SIMPLE_MENU_CLICK, XRT_INPUT_TOUCH_MENU_CLICK},
@@ -151,6 +161,52 @@ print_controller_state(struct rift_s_controller *ctrl)
 }
 #endif
 
+/*!
+ * Map the current IMU sample into the monotonic clock and feed it to the
+ * fusion filter (and the recorder). Called with the controller mutex held,
+ * after ctrl->gyro / ctrl->accel have been updated.
+ */
+static void
+feed_fusion_imu(struct rift_s_controller *ctrl, timepoint_ns local_ts)
+{
+	if (ctrl->imu_clock == NULL) {
+		return;
+	}
+
+	timepoint_ns device_ns = ctrl->last_imu_device_time_ns;
+	m_clock_windowed_skew_tracker_push(ctrl->imu_clock, local_ts, device_ns);
+
+	timepoint_ns mono_ns;
+	if (!m_clock_windowed_skew_tracker_to_local(ctrl->imu_clock, device_ns, &mono_ns)) {
+		return; // Clock estimator not synchronised yet
+	}
+	mono_ns += (timepoint_ns)ctrl->imu_time_offset_us * OS_NS_PER_USEC;
+
+	if (ctrl->last_imu_mono_ns != 0 && mono_ns <= ctrl->last_imu_mono_ns) {
+		if (ctrl->last_imu_mono_ns - mono_ns > 100 * U_TIME_1MS_IN_NS) {
+			// Controller clock jumped (e.g. power save), start the clock estimate again
+			RIFT_S_WARN("Controller %016" PRIx64 " IMU time went backward, resetting clock tracking",
+			            ctrl->device_id);
+			m_clock_windowed_skew_tracker_reset(ctrl->imu_clock);
+			ctrl->last_imu_mono_ns = 0;
+			if (ctrl->ctrl_fusion != NULL) {
+				rift_s_ctrl_fusion_reset(ctrl->ctrl_fusion);
+			}
+		}
+		return;
+	}
+	ctrl->last_imu_mono_ns = mono_ns;
+
+	if (ctrl->record_imu != NULL) {
+		fprintf(ctrl->record_imu, "%" PRId64 ",%" PRId64 ",%" PRId64 ",%f,%f,%f,%f,%f,%f\n", mono_ns, device_ns,
+		        local_ts, ctrl->gyro.x, ctrl->gyro.y, ctrl->gyro.z, ctrl->accel.x, ctrl->accel.y, ctrl->accel.z);
+	}
+
+	if (ctrl->ctrl_fusion != NULL) {
+		rift_s_ctrl_fusion_imu(ctrl->ctrl_fusion, mono_ns, &ctrl->gyro, &ctrl->accel);
+	}
+}
+
 static void
 handle_imu_update(struct rift_s_controller *ctrl,
                   timepoint_ns local_ts,
@@ -206,6 +262,8 @@ handle_imu_update(struct rift_s_controller *ctrl,
 	m_imu_3dof_update(&ctrl->fusion, ctrl->last_imu_device_time_ns, &ctrl->accel, &ctrl->gyro);
 	ctrl->pose.orientation = ctrl->fusion.rot;
 
+	feed_fusion_imu(ctrl, local_ts);
+
 #if 0
 	RIFT_S_DEBUG("%" PRIx64 " dt %u device time %u ns %" PRIu64
 	             " raw accel %d %d %d gyro %d %d %d -> accel %f %f %f  gyro %f %f %f\n",
@@ -644,12 +702,17 @@ rift_s_controller_get_tracked_pose(struct xrt_device *xdev,
 	/* Apply the fusion rotation */
 	struct xrt_space_relation *rel = m_relation_chain_reserve(&xrc);
 
-	rift_s_controller_get_fusion_pose(ctrl, name, at_timestamp_ns, rel);
-	if (ctrl->last_tracked_pose_ts != 0) {
-		rel->pose.position = ctrl->last_tracked_pose.position;
-		rel->linear_velocity = rift_s_controller_estimate_linear_velocity(ctrl, os_monotonic_get_ns());
-		rel->relation_flags |=(enum xrt_space_relation_flags)(XRT_SPACE_RELATION_POSITION_VALID_BIT |
-		                                                       XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+	// Prefer the 6DoF fusion: IMU pose predicted / interpolated to the requested time
+	bool have_fusion_pose = ctrl->use_fusion && ctrl->ctrl_fusion != NULL &&
+	                        rift_s_ctrl_fusion_get_relation(ctrl->ctrl_fusion, at_timestamp_ns, rel);
+	if (!have_fusion_pose) {
+		rift_s_controller_get_fusion_pose(ctrl, name, at_timestamp_ns, rel);
+		if (ctrl->last_tracked_pose_ts != 0) {
+			rel->pose.position = ctrl->last_tracked_pose.position;
+			rel->linear_velocity = rift_s_controller_estimate_linear_velocity(ctrl, os_monotonic_get_ns());
+			rel->relation_flags |= (enum xrt_space_relation_flags)(XRT_SPACE_RELATION_POSITION_VALID_BIT |
+			                                                       XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+		}
 	}
 	os_mutex_unlock(&ctrl->mutex);
 
@@ -683,6 +746,18 @@ rift_s_controller_destroy(struct xrt_device *xdev)
 
 	m_imu_3dof_close(&ctrl->fusion);
 
+	rift_s_ctrl_fusion_destroy(&ctrl->ctrl_fusion);
+	if (ctrl->imu_clock != NULL) {
+		m_clock_windowed_skew_tracker_destroy(ctrl->imu_clock);
+		ctrl->imu_clock = NULL;
+	}
+	if (ctrl->record_imu != NULL) {
+		fclose(ctrl->record_imu);
+	}
+	if (ctrl->record_optical != NULL) {
+		fclose(ctrl->record_optical);
+	}
+
 	os_mutex_destroy(&ctrl->mutex);
 
 	u_device_free(&ctrl->base);
@@ -744,7 +819,23 @@ rift_s_controller_push_observed_pose(struct xrt_device *xdev, timepoint_ns frame
 	ctrl->last_tracked_pose_ts = frame_mono_ns;
 	ctrl->last_tracked_pose = *pose;
 
-	if (ctrl->update_yaw_from_optical) {
+	bool fusion_active = false;
+	if (ctrl->ctrl_fusion != NULL) {
+		enum rift_s_ctrl_fusion_pose_result res =
+		    rift_s_ctrl_fusion_pose(ctrl->ctrl_fusion, frame_mono_ns, pose);
+		rift_s_ctrl_fusion_get_stats(ctrl->ctrl_fusion, &ctrl->fusion_stats);
+		fusion_active = ctrl->use_fusion && rift_s_ctrl_fusion_is_initialised(ctrl->ctrl_fusion);
+
+		if (ctrl->record_optical != NULL) {
+			fprintf(ctrl->record_optical, "%" PRId64 ",%" PRId64 ",%f,%f,%f,%f,%f,%f,%f,%d\n", frame_mono_ns,
+			        os_monotonic_get_ns(), pose->position.x, pose->position.y, pose->position.z,
+			        pose->orientation.x, pose->orientation.y, pose->orientation.z, pose->orientation.w,
+			        (int)res);
+		}
+	}
+
+	// The 3DoF yaw nudging is only needed when the fusion filter isn't driving the pose
+	if (ctrl->update_yaw_from_optical && !fusion_active) {
 		// Apply 5% of observed orientation yaw to 3dof fusion
 		// FIXME: Do better
 		struct xrt_quat delta;
@@ -786,6 +877,67 @@ rift_s_controller_push_observed_pose(struct xrt_device *xdev, timepoint_ns frame
 	os_mutex_unlock(&ctrl->mutex);
 }
 
+static FILE *
+open_record_file(const char *dir, const char *side, int64_t start_ns, const char *kind, const char *header)
+{
+	char path[1024];
+	(void)snprintf(path, sizeof(path), "%s/rift_s_%s_%" PRId64 "_%s.csv", dir, side, start_ns, kind);
+	FILE *f = fopen(path, "w");
+	if (f == NULL) {
+		RIFT_S_ERROR("Could not open controller recording file %s", path);
+		return NULL;
+	}
+	fprintf(f, "%s\n", header);
+	RIFT_S_INFO("Recording controller %s data to %s", kind, path);
+	return f;
+}
+
+static void
+rift_s_controller_setup_fusion(struct rift_s_controller *ctrl)
+{
+	ctrl->use_fusion = debug_get_bool_option_rift_s_ctrl_fusion();
+	ctrl->imu_clock = m_clock_windowed_skew_tracker_alloc(CTRL_IMU_CLOCK_WINDOW);
+
+	struct rift_s_ctrl_fusion_params params;
+	rift_s_ctrl_fusion_default_params(&params);
+	ctrl->ctrl_fusion = rift_s_ctrl_fusion_create(&params);
+
+	const char *record_dir = debug_get_option_rift_s_ctrl_record();
+	if (record_dir != NULL) {
+		const char *side = ctrl->device_type == RIFT_S_DEVICE_LEFT_CONTROLLER ? "left" : "right";
+		int64_t now = os_monotonic_get_ns();
+		ctrl->record_imu = open_record_file(record_dir, side, now, "imu",
+		                                    "mono_ns,device_ns,arrival_ns,gx,gy,gz,ax,ay,az");
+		ctrl->record_optical = open_record_file(record_dir, side, now, "optical",
+		                                        "frame_ns,arrival_ns,px,py,pz,qx,qy,qz,qw,result");
+	}
+
+	struct rift_s_ctrl_fusion_params *p = rift_s_ctrl_fusion_params_ptr(ctrl->ctrl_fusion);
+	struct rift_s_ctrl_fusion_stats *st = &ctrl->fusion_stats;
+	u_var_add_gui_header(ctrl, NULL, "6DoF Fusion");
+	u_var_add_bool(ctrl, &ctrl->use_fusion, "Use IMU + optical fusion");
+	u_var_add_i32(ctrl, &ctrl->imu_time_offset_us, "IMU time offset (us)");
+	u_var_add_ro_u64(ctrl, &st->poses_accepted, "Optical poses accepted");
+	u_var_add_ro_u64(ctrl, &st->poses_rejected, "Optical poses rejected");
+	u_var_add_ro_u64(ctrl, &st->resets, "Filter resets");
+	u_var_add_ro_u64(ctrl, &st->poses_ignored, "Optical poses ignored (too old)");
+	u_var_add_ro_f32(ctrl, &st->last_chi2, "Last innovation chi2");
+	u_var_add_ro_f32(ctrl, &st->last_pos_innovation, "Last position innovation (m)");
+	u_var_add_ro_f32(ctrl, &st->last_fix_delay, "Last fix delay (s)");
+	u_var_add_ro_vec3_f32(ctrl, &st->gyro_bias, "Gyro bias (rad/s)");
+	u_var_add_ro_vec3_f32(ctrl, &st->accel_bias, "Accel bias (m/s2)");
+	u_var_add_f32(ctrl, &p->optical_pos_sigma, "Optical position sigma (m)");
+	u_var_add_f32(ctrl, &p->optical_rot_sigma, "Optical rotation sigma (rad)");
+	u_var_add_f32(ctrl, &p->accel_noise, "Accel noise");
+	u_var_add_f32(ctrl, &p->gyro_noise, "Gyro noise");
+	u_var_add_f32(ctrl, &p->gate_chi2, "Gate chi2");
+	u_var_add_f32(ctrl, &p->coast_start, "Coast start (s)");
+	u_var_add_f32(ctrl, &p->coast_vel_tau, "Coast velocity decay tau (s)");
+	u_var_add_f32(ctrl, &p->coast_max, "Coast max / hold after (s)");
+	u_var_add_f32(ctrl, &p->prediction_max, "Max prediction (s)");
+	u_var_add_bool(ctrl, &p->predict_with_accel, "Predict with acceleration");
+}
+
 static struct t_constellation_tracked_device_callbacks tracking_callbacks = {
     .get_led_model = rift_s_controller_get_led_model,
     .notify_frame_received = NULL,
@@ -904,6 +1056,8 @@ rift_s_controller_create(struct rift_s_system *sys, enum xrt_device_type device_
 	DEBUG_TOUCH_INPUT_VEC2(ctrl, THUMBSTICK, "Thumbstick X", "Thumbstick Y");
 	DEBUG_TOUCH_INPUT_BOOL(ctrl, THUMBREST_TOUCH, "Thumbrest touch");
 
+	rift_s_controller_setup_fusion(ctrl);
+
 	struct rift_s_tracker *tracker = rift_s_system_get_tracker(sys);
 	ctrl->update_yaw_from_optical = true;
 	ctrl->tracking_connection = rift_s_tracker_add_controller(tracker, &ctrl->base, &tracking_callbacks);
