From b8c640ec0bcbc3c9c345d00ea0b23fcae91a2a49 Mon Sep 17 00:00:00 2001
From: Kunstbanause <3209654+Kunstbanause@users.noreply.github.com>
Date: Sun, 25 Oct 2026 11:57:54 +0100
Subject: [PATCH 41/46] d/rift_s: Keep the clock-resync camera frame out of
 SLAM

The cherry-picked resync accepts a frame whose time maps far into the
past. lbgos/rift-s-linux drops it later as not fresh; this tree has no
freshness check, so it would reach Basalt with that time. Skip SLAM and
passthrough for it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/xrt/drivers/rift_s/rift_s_tracker.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/xrt/drivers/rift_s/rift_s_tracker.c b/src/xrt/drivers/rift_s/rift_s_tracker.c
index 89a8798..e4fcba0 100644
--- a/src/xrt/drivers/rift_s/rift_s_tracker.c
+++ b/src/xrt/drivers/rift_s/rift_s_tracker.c
@@ -869,7 +869,8 @@ rift_s_tracker_push_slam_frames(struct rift_s_tracker *t,
 
 
 	timepoint_ns frame_mono_ns = raw_frame_ts_to_mono_ts(t, frame_ts_ns);
-	if (t->last_frame_time - frame_mono_ns > (timepoint_ns)U_TIME_1S_IN_NS) {
+	bool discontinuity = t->last_frame_time - frame_mono_ns > (timepoint_ns)U_TIME_1S_IN_NS;
+	if (discontinuity) {
 		/* A clock discontinuity, not jitter. At startup IMU samples are ignored until the
 		 * first frame is accepted, so the first frame's epoch offset is computed without
 		 * IMU time; when the IMU clock is a 2^32 us epoch ahead that frame maps far into
@@ -888,6 +889,12 @@ rift_s_tracker_push_slam_frames(struct rift_s_tracker *t,
 	t->last_frame_time = frame_mono_ns;
 	os_mutex_unlock(&t->mutex);
 
+	/* The resyncing frame's time is wrong: it only ungates the IMU. SLAM and passthrough start
+	 * with the next frame, which gets the corrected epoch offset. */
+	if (discontinuity) {
+		return;
+	}
+
 	// The SLAM system expects exactly the configured cameras, in order
 	const int slam_cams = rift_s_slam_cam_count();
 	for (int i = 0; i < RIFT_S_CAMERA_COUNT; i++) {
-- 
