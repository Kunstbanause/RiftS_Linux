From 7fb1e2d565849026fa13bcbd1596fa13dc7f7a32 Mon Sep 17 00:00:00 2001
From: lbgos <285507185+lbgos@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:58:44 +0300
Subject: [PATCH 27/46] rift_s: fix controller index bounds assertion

The || accepted every index (-1 and past-the-end alike), guarding an
out-of-bounds controllers[] access with a check that cannot fail.

(cherry picked from commit e21fdf33fb84e958056481873131b792ed16e03f)
---
 src/xrt/drivers/rift_s/rift_s.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/xrt/drivers/rift_s/rift_s.c b/src/xrt/drivers/rift_s/rift_s.c
index 3019a85..fce309c 100644
--- a/src/xrt/drivers/rift_s/rift_s.c
+++ b/src/xrt/drivers/rift_s/rift_s.c
@@ -638,7 +638,7 @@ rift_s_system_remove_hmd(struct rift_s_system *sys)
 struct xrt_device *
 rift_s_system_get_controller(struct rift_s_system *sys, int index)
 {
-	assert(index >= 0 || index < MAX_TRACKED_DEVICES);
+	assert(index >= 0 && index < MAX_TRACKED_DEVICES);
 	assert(sys->controllers[index] == NULL); // Ensure only called once per controller
 
 	os_mutex_lock(&sys->dev_mutex);
-- 
2.56.0

