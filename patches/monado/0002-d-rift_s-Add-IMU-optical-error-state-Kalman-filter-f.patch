+TEST_CASE("rift_s_ctrl_fusion: short occlusion is bridged and recovers")
+{
+	Sim sim;
+	const int64_t occl_start = 4000 * kMs;
+	const int64_t occl_end = occl_start + 300 * kMs;
+	sim.drop_from = occl_start;
+	sim.drop_to = occl_end;
+
+	ErrorStats during, after, baseline_during;
+	for (int64_t t = kImuPeriod; t < 6000 * kMs; t += kImuPeriod) {
+		sim.tick(t);
+		Vector3d truth = sim.traj.pos(s_of(t));
+		if (t >= occl_start + kFixDelay && t < occl_end + kFixDelay) {
+			during.add((sim.fused_pos(t) - truth).norm());
+			baseline_during.add((sim.last_fix_pos - truth).norm());
+		} else if (t > occl_end + kFixDelay + 150 * kMs) {
+			after.add((sim.fused_pos(t) - truth).norm());
+		}
+	}
+	INFO("during max " << during.max << " baseline during max " << baseline_during.max << " after rms "
+	                   << after.rms());
+	CHECK(during.max < 0.08);
+	CHECK(during.max < 0.8 * baseline_during.max);
+	CHECK(after.rms() < 0.005);
+}
+
+TEST_CASE("rift_s_ctrl_fusion: long occlusion holds position, then re-acquires")
+{
+	Sim sim;
+	const int64_t occl_start = 3000 * kMs;
+	const int64_t occl_end = occl_start + 2000 * kMs;
+	sim.drop_from = occl_start;
+	sim.drop_to = occl_end;
+
+	bool saw_untracked = false;
+	ErrorStats after;
+	for (int64_t t = kImuPeriod; t < 7000 * kMs; t += kImuPeriod) {
+		sim.tick(t);
+		if (t < kWarmup) {
+			continue;
+		}
+		xrt_space_relation rel{};
+		Vector3d p = sim.fused_pos(t, &rel);
+		if (t > occl_start + 1000 * kMs && t < occl_end) {
+			CHECK((rel.relation_flags & XRT_SPACE_RELATION_POSITION_TRACKED_BIT) == 0);
+			CHECK((rel.relation_flags & XRT_SPACE_RELATION_POSITION_VALID_BIT) != 0);
+			saw_untracked = true;
+		}
+		if (t > occl_end + kFixDelay + 200 * kMs) {
+			after.add((p - sim.traj.pos(s_of(t))).norm());
+		}
+	}
+	INFO("after rms " << after.rms());
+	CHECK(saw_untracked);
+	CHECK(after.rms() < 0.005);
+}
