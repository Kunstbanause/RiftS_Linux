+// Copyright 2026, Kunstbanause.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Camera passthrough for the main compositor.
+ * @ingroup comp_main
+ */
+
+#include "xrt/xrt_frame.h"
+
+#include "math/m_api.h"
+
+#include "util/u_debug.h"
+#include "util/u_logging.h"
+#include "util/u_misc.h"
+#include "util/u_time.h"
+#include "util/u_var.h"
+
+#include "vk/vk_mini_helpers.h"
+
+#include "main/comp_passthrough.h"
+
+#include <math.h>
+#include <string.h>
+
+
+//! Distance of the sphere the camera images are projected on
+DEBUG_GET_ONCE_FLOAT_OPTION(passthrough_distance, "XRT_PASSTHROUGH_DISTANCE_M", 2.0f)
+//! Brightness multiplier for the camera images
+DEBUG_GET_ONCE_FLOAT_OPTION(passthrough_gain, "XRT_PASSTHROUGH_GAIN", 1.0f)
+//! Fade time when the forced passthrough is toggled
+DEBUG_GET_ONCE_FLOAT_OPTION(passthrough_fade, "XRT_PASSTHROUGH_FADE_S", 0.15f)
+//! Log a summary once a second, for debugging
+DEBUG_GET_ONCE_BOOL_OPTION(passthrough_stats, "XRT_PASSTHROUGH_STATS", false)
+
+
+/*
+ *
+ * Helpers.
+ *
+ */
+
+static void
+release_frames(struct xrt_passthrough_frames *frames)
+{
+	for (uint32_t i = 0; i < XRT_MAX_PASSTHROUGH_CAMERAS; i++) {
+		xrt_frame_reference(&frames->cameras[i].frame, NULL);
+	}
+	frames->camera_count = 0;
+}
+
+static void
+camera_fini(struct vk_bundle *vk, struct comp_passthrough_camera *cam)
+{
+	D(ImageView, cam->view);
+	D(Image, cam->image);
+	DF(Memory, cam->memory);
+	render_buffer_fini(vk, &cam->staging);
+	U_ZERO(cam);
+}
+
+static bool
+camera_init(struct vk_bundle *vk, struct comp_passthrough_camera *cam, uint32_t width, uint32_t height)
+{
+	VkResult ret;
+	VkExtent2D extent = {width, height};
+	VkFormat format = VK_FORMAT_R8_UNORM;
+
+	ret = vk_create_image_simple(                                     //
+	    vk,                                                           // vk_bundle
+	    extent,                                                       // extent
+	    format,                                                       // format
+	    VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT, // usage
+	    &cam->memory,                                                 // out_mem
+	    &cam->image);                                                 // out_image
+	if (ret != VK_SUCCESS) {
+		U_LOG_E("Passthrough: vk_create_image_simple: %s", vk_result_string(ret));
+		return false;
+	}
+
+	VkImageSubresourceRange subresource_range = {
+	    .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+	    .baseMipLevel = 0,
+	    .levelCount = 1,
+	    .baseArrayLayer = 0,
+	    .layerCount = 1,
+	};
+
+	ret = vk_create_view(      //
+	    vk,                    // vk_bundle
+	    cam->image,            // image
+	    VK_IMAGE_VIEW_TYPE_2D, // type
+	    format,                // format
+	    subresource_range,     // subresource_range
+	    &cam->view);           // out_view
+	if (ret != VK_SUCCESS) {
+		U_LOG_E("Passthrough: vk_create_view: %s", vk_result_string(ret));
+		return false;
+	}
+
+	ret = render_buffer_init(                                                      //
+	    vk,                                                                        // vk_bundle
+	    &cam->staging,                                                             // buffer
+	    VK_BUFFER_USAGE_TRANSFER_SRC_BIT,                                          // usage_flags
+	    VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, // memory_property_flags
+	    (VkDeviceSize)width * height);                                             // size
+	if (ret != VK_SUCCESS) {
+		U_LOG_E("Passthrough: render_buffer_init: %s", vk_result_string(ret));
+		return false;
+	}
+
+	ret = render_buffer_map(vk, &cam->staging);
+	if (ret != VK_SUCCESS) {
+		U_LOG_E("Passthrough: render_buffer_map: %s", vk_result_string(ret));
+		return false;
+	}
+
+	cam->width = width;
+	cam->height = height;
+
+	return true;
+}
+
+//! (Re)create the camera images to fit the frames, returns false if that failed
+static bool
+ensure_cameras(struct comp_passthrough *pt, const struct xrt_passthrough_frames *frames)
+{
+	bool fits = pt->cam_count == frames->camera_count;
+	for (uint32_t i = 0; fits && i < frames->camera_count; i++) {
+		const struct xrt_frame *xf = frames->cameras[i].frame;
+		fits = pt->cams[i].width == xf->width && pt->cams[i].height == xf->height;
+	}
+	if (fits) {
+		return true;
+	}
+
+	// Only happens on first use, the GPU is idle between frames (see comp_renderer_draw).
+	for (uint32_t i = 0; i < XRT_MAX_PASSTHROUGH_CAMERAS; i++) {
+		camera_fini(pt->vk, &pt->cams[i]);
+	}
+	pt->cam_count = 0;
+	pt->gpu_timestamp_ns = 0;
+
+	for (uint32_t i = 0; i < frames->camera_count; i++) {
+		const struct xrt_frame *xf = frames->cameras[i].frame;
+		if (!camera_init(pt->vk, &pt->cams[i], xf->width, xf->height)) {
+			for (uint32_t k = 0; k <= i; k++) {
+				camera_fini(pt->vk, &pt->cams[k]);
+			}
+			return false;
+		}
+	}
+	pt->cam_count = frames->camera_count;
+
+	U_LOG_I("Passthrough: created %u camera images (%ux%u)", pt->cam_count, pt->cams[0].width,
+	        pt->cams[0].height);
+
+	return true;
+}
+
+//! Usable for the shader: one L8 image per view
+static bool
+frames_valid(const struct xrt_passthrough_frames *frames)
+{
+	if (frames->camera_count != XRT_MAX_PASSTHROUGH_CAMERAS) {
+		return false;
+	}
+	for (uint32_t i = 0; i < frames->camera_count; i++) {
+		const struct xrt_frame *xf = frames->cameras[i].frame;
+		if (xf == NULL || xf->format != XRT_FORMAT_L8 || xf->width == 0 || xf->height == 0) {
+			return false;
+		}
+	}
+	return true;
+}
+
+
+static double
+image_brightness(const struct xrt_frame *xf)
+{
+	uint64_t sum = 0, count = 0;
+	for (uint32_t y = 0; y < xf->height; y += 8) {
+		for (uint32_t x = 0; x < xf->width; x += 8) {
+			sum += xf->data[(size_t)y * xf->stride + x];
+			count++;
+		}
+	}
+	return count ? (double)sum / (double)count : 0.0;
+}
+
+static void
+stats_flush(struct comp_passthrough *pt, int64_t now_ns)
+{
+	if (!pt->stats.enabled) {
+		return;
+	}
+	if (pt->stats.window_start_ns == 0) {
+		pt->stats.window_start_ns = now_ns;
+		pt->stats.brightness_min = 1e9;
+		return;
+	}
+	if (now_ns - pt->stats.window_start_ns < U_TIME_1S_IN_NS) {
+		return;
+	}
+	if (pt->stats.drawn > 0 || pt->stats.no_images > 0) {
+		U_LOG_W("Passthrough: frames %u drawn %u no_images %u pose_failed %u uploads %u max_age %.1f ms "
+		        "brightness %.1f..%.1f requery %.3f deg opacity %.2f bg %d",
+		        pt->stats.frames, pt->stats.drawn, pt->stats.no_images, pt->stats.pose_failed,
+		        pt->stats.uploads, pt->stats.max_age_ms, pt->stats.brightness_min, pt->stats.brightness_max,
+		        pt->stats.max_requery_deg, pt->opacity, pt->background);
+	}
+	bool enabled = pt->stats.enabled;
+	U_ZERO(&pt->stats);
+	pt->stats.enabled = enabled;
+	pt->stats.window_start_ns = now_ns;
+	pt->stats.brightness_min = 1e9;
+}
+
+/*
+ *
+ * 'Exported' functions.
+ *
+ */
+
+void
+comp_passthrough_init(struct comp_passthrough *pt, struct vk_bundle *vk)
+{
+	U_ZERO(pt);
+	pt->vk = vk;
+
+	pt->settings.radius_m = debug_get_float_option_passthrough_distance();
+	pt->settings.gain = debug_get_float_option_passthrough_gain();
+	pt->settings.fade_s = debug_get_float_option_passthrough_fade();
+	pt->stats.enabled = debug_get_bool_option_passthrough_stats();
+
+	u_var_add_root(pt, "Compositor: Passthrough", false);
+	u_var_add_bool(pt, &pt->settings.force, "Force on");
+	u_var_add_f32(pt, &pt->settings.radius_m, "Distance (m)");
+	u_var_add_f32(pt, &pt->settings.gain, "Gain");
+	u_var_add_f32(pt, &pt->settings.fade_s, "Fade (s)");
+	u_var_add_bool(pt, &pt->settings.head_locked, "Debug: head locked (no capture time pose)");
+	u_var_add_ro_f32(pt, &pt->opacity, "Opacity");
+}
+
+void
+comp_passthrough_fini(struct comp_passthrough *pt)
+{
+	u_var_remove_root(pt);
+
+	release_frames(&pt->frames);
+	for (uint32_t i = 0; i < XRT_MAX_PASSTHROUGH_CAMERAS; i++) {
+		camera_fini(pt->vk, &pt->cams[i]);
+	}
+	pt->cam_count = 0;
+}
+
+bool
+comp_passthrough_update(struct comp_passthrough *pt,
+                        struct xrt_device *xdev,
+                        enum xrt_blend_mode blend_mode,
+                        int64_t now_ns)
+{
+	pt->enabled = false;
+
+	if (pt->unsupported || pt->failed) {
+		return false;
+	}
+
+	stats_flush(pt, now_ns);
+	pt->stats.frames++;
+
+	// Cheap poll for the forced flag first, images are only copied while we ask for them.
+	struct xrt_passthrough_frames poll = {0};
+	xrt_result_t xret = xrt_device_get_passthrough_frames(xdev, false, &poll);
+	if (xret == XRT_ERROR_NOT_IMPLEMENTED) {
+		pt->unsupported = true;
+		return false;
+	}
+	release_frames(&poll);
+	if (xret != XRT_SUCCESS) {
+		return false;
+	}
+
+	bool forced = poll.forced || pt->settings.force;
+	bool background_wanted = blend_mode == XRT_BLEND_MODE_ALPHA_BLEND;
+
+	// Fade the forced passthrough in and out.
+	float dt_s = pt->last_update_ns != 0 ? (float)time_ns_to_s(now_ns - pt->last_update_ns) : 0.0f;
+	pt->last_update_ns = now_ns;
+	dt_s = CLAMP(dt_s, 0.0f, 0.1f);
+	float step = pt->settings.fade_s > 0.0f ? dt_s / pt->settings.fade_s : 1.0f;
+	pt->opacity = forced ? MIN(pt->opacity + step, 1.0f) : MAX(pt->opacity - step, 0.0f);
+
+	if (!background_wanted && !forced && pt->opacity <= 0.0f) {
+		// Not needed, let go of the images so the device stops copying.
+		release_frames(&pt->frames);
+		pt->upload_pending = false;
+		pt->gpu_timestamp_ns = 0;
+		return false;
+	}
+
+	struct xrt_passthrough_frames latest = {0};
+	xret = xrt_device_get_passthrough_frames(xdev, true, &latest);
+	if (xret != XRT_SUCCESS || !frames_valid(&latest)) {
+		pt->stats.no_images++;
+		// No (recent) images, show nothing rather than a frozen room.
+		release_frames(&latest);
+		release_frames(&pt->frames);
+		pt->upload_pending = false;
+		pt->gpu_timestamp_ns = 0;
+		return false;
+	}
+
+	bool is_new = pt->frames.camera_count == 0 ||
+	              latest.cameras[0].timestamp_ns != pt->frames.cameras[0].timestamp_ns;
+	if (is_new) {
+		release_frames(&pt->frames);
+		pt->frames = latest; // Takes over the references.
+
+		if (!ensure_cameras(pt, &pt->frames)) {
+			U_LOG_E("Passthrough: could not create the camera images, disabling passthrough");
+			pt->failed = true;
+			release_frames(&pt->frames);
+			return false;
+		}
+		pt->upload_pending = true;
+
+		if (pt->stats.enabled) {
+			pt->stats.uploads++;
+			double b = image_brightness(pt->frames.cameras[0].frame);
+			pt->stats.brightness_min = MIN(pt->stats.brightness_min, b);
+			pt->stats.brightness_max = MAX(pt->stats.brightness_max, b);
+		}
+	} else {
+		release_frames(&latest);
+	}
+	pt->stats.max_age_ms = MAX(pt->stats.max_age_ms, (double)(now_ns - pt->frames.cameras[0].timestamp_ns) / U_TIME_1MS_IN_NS);
+
+	// Both while fading over an alpha blend app, else it would fade in from black.
+	pt->background = background_wanted;
+	pt->enabled = pt->background || pt->opacity > 0.0f;
+
+	return pt->enabled;
+}
+
+void
+comp_passthrough_record_upload(struct comp_passthrough *pt, VkCommandBuffer cmd)
+{
+	if (!pt->upload_pending) {
+		return;
+	}
+
+	struct vk_bundle *vk = pt->vk;
+
+	VkImageSubresourceRange subresource_range = {
+	    .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+	    .baseMipLevel = 0,
+	    .levelCount = 1,
+	    .baseArrayLayer = 0,
+	    .layerCount = 1,
+	};
+
+	VkImageSubresourceLayers subresource_layers = {
+	    .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+	    .mipLevel = 0,
+	    .baseArrayLayer = 0,
+	    .layerCount = 1,
+	};
+
+	for (uint32_t i = 0; i < pt->cam_count; i++) {
+		struct comp_passthrough_camera *cam = &pt->cams[i];
+		const struct xrt_frame *xf = pt->frames.cameras[i].frame;
+
+		// The previous frame's copy has finished, the renderer waits for the queue to be idle each frame.
+		uint8_t *dst = cam->staging.mapped;
+		for (uint32_t y = 0; y < cam->height; y++) {
+			memcpy(dst + (size_t)y * cam->width, xf->data + (size_t)y * xf->stride, cam->width);
+		}
+
+		// The whole image is overwritten, so the old content can be discarded.
+		vk_cmd_image_barrier_gpu_locked(          //
+		    vk,                                   //
+		    cmd,                                  //
+		    cam->image,                           //
+		    0,                                    //
+		    VK_ACCESS_TRANSFER_WRITE_BIT,         //
+		    VK_IMAGE_LAYOUT_UNDEFINED,            //
+		    VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, //
+		    subresource_range);                   //
+
+		VkBufferImageCopy region = {
+		    .bufferOffset = 0,
+		    .bufferRowLength = 0,
+		    .bufferImageHeight = 0,
+		    .imageSubresource = subresource_layers,
+		    .imageOffset = {0, 0, 0},
+		    .imageExtent = {cam->width, cam->height, 1},
+		};
+
+		vk->vkCmdCopyBufferToImage(               //
+		    cmd,                                  // commandBuffer
+		    cam->staging.buffer,                  // srcBuffer
+		    cam->image,                           // dstImage
+		    VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, // dstImageLayout
+		    1,                                    // regionCount
+		    &region);                             // pRegions
+
+		vk_cmd_image_barrier_gpu_locked(              //
+		    vk,                                       //
+		    cmd,                                      //
+		    cam->image,                               //
+		    VK_ACCESS_TRANSFER_WRITE_BIT,             //
+		    VK_ACCESS_SHADER_READ_BIT,                //
+		    VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,     //
+		    VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, //
+		    subresource_range);                       //
+	}
+
+	pt->gpu_timestamp_ns = pt->frames.cameras[0].timestamp_ns;
+	pt->upload_pending = false;
+}
+
+void
+comp_passthrough_fill_render_data(struct comp_passthrough *pt,
+                                  struct xrt_device *xdev,
+                                  int64_t display_time_ns,
+                                  uint32_t first_overlay_layer,
+                                  struct comp_render_passthrough_data *out)
+{
+	U_ZERO(out);
+
+	if (!pt->enabled || pt->gpu_timestamp_ns == 0) {
+		return;
+	}
+
+	// Head pose when the images were taken, so they stay put in the world while the head moves.
+	int64_t pose_time_ns = pt->settings.head_locked ? display_time_ns : pt->gpu_timestamp_ns;
+	struct xrt_space_relation head = XRT_SPACE_RELATION_ZERO;
+	xrt_result_t xret = xrt_device_get_tracked_pose(xdev, XRT_INPUT_GENERIC_HEAD_POSE, pose_time_ns, &head);
+	if (xret != XRT_SUCCESS || (head.relation_flags & XRT_SPACE_RELATION_ORIENTATION_VALID_BIT) == 0) {
+		pt->stats.pose_failed++;
+		return;
+	}
+
+	// Does the pose for the same image change from frame to frame (the tracker revising its history)?
+	if (pt->stats.enabled && pt->stats.last_pose_ts == pose_time_ns) {
+		struct xrt_quat inv, delta;
+		math_quat_invert(&pt->stats.last_pose.orientation, &inv);
+		math_quat_rotate(&inv, &head.pose.orientation, &delta);
+		double deg = 2.0 * acos(fmin(fabs((double)delta.w), 1.0)) * 180.0 / M_PI;
+		pt->stats.max_requery_deg = MAX(pt->stats.max_requery_deg, deg);
+	}
+	pt->stats.last_pose = head.pose;
+	pt->stats.last_pose_ts = pose_time_ns;
+	pt->stats.drawn++;
+
+	out->enabled = true;
+	out->background = pt->background;
+	out->opacity = pt->opacity;
+	out->first_overlay_layer = first_overlay_layer;
+	out->gain = pt->settings.gain;
+	out->radius_m = MAX(pt->settings.radius_m, 0.1f);
+
+	for (uint32_t i = 0; i < pt->cam_count && i < XRT_MAX_VIEWS; i++) {
+		const struct xrt_passthrough_camera *cam = &pt->frames.cameras[i];
+
+		out->views[i].image_view = pt->cams[i].view;
+		math_pose_transform(&head.pose, &cam->head_from_camera, &out->views[i].world_from_camera);
+
+		float *in = out->views[i].intrinsics;
+		in[0] = cam->fx;
+		in[1] = cam->fy;
+		in[2] = cam->cx;
+		in[3] = cam->cy;
+		for (int k = 0; k < 6; k++) {
+			in[4 + k] = cam->k[k];
+		}
+		in[10] = cam->p1;
+		in[11] = cam->p2;
+
+		out->views[i].width = pt->cams[i].width;
+		out->views[i].height = pt->cams[i].height;
+	}
+}
