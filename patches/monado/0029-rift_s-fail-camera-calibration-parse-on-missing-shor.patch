From f35293ee1b8d6bfbd8a37ff18b2f08458855df8d Mon Sep 17 00:00:00 2001
From: lbgos <285507185+lbgos@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:58:58 +0300
Subject: [PATCH 29/46] rift_s: fail camera calibration parse on missing/short
 entry list

A missing CameraCalibration array returned false (== success) and
leaked the JSON root, and a short list left zeroed cameras that the
tracker indexes unconditionally. Require all five.

(cherry picked from commit 3639b9563cf3d21217c33728c37a649d88e0d1a5)
---
 src/xrt/drivers/rift_s/rift_s_firmware.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/xrt/drivers/rift_s/rift_s_firmware.c b/src/xrt/drivers/rift_s/rift_s_firmware.c
index 9e7a865..11d2feb 100644
--- a/src/xrt/drivers/rift_s/rift_s_firmware.c
+++ b/src/xrt/drivers/rift_s/rift_s_firmware.c
@@ -275,7 +275,7 @@ rift_s_parse_camera_calibration_block(char *json_string, struct rift_s_camera_ca
 	cJSON *cameras = cJSON_GetObjectItemCaseSensitive(json_root, "CameraCalibration");
 	if (!cJSON_IsArray(cameras)) {
 		RIFT_S_ERROR("Cameras: not found or not an Array");
-		return false;
+		goto fail;
 	}
 
 	int camera_id = 0;
@@ -293,6 +293,10 @@ rift_s_parse_camera_calibration_block(char *json_string, struct rift_s_camera_ca
 		camera_id++;
 	}
 
+	if (camera_id != RIFT_S_CAMERA_COUNT) {
+		RIFT_S_ERROR("Expected %d camera calibration entries, got %d", RIFT_S_CAMERA_COUNT, camera_id);
+		goto fail;
+	}
 
 	cJSON_Delete(json_root);
 	return 0;
-- 
