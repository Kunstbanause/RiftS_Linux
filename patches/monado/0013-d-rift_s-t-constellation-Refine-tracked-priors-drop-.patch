diff --git a/src/xrt/drivers/rift_s/rift_s_controller.c b/src/xrt/drivers/rift_s/rift_s_controller.c
index b8ec166..a4412a0 100644
--- a/src/xrt/drivers/rift_s/rift_s_controller.c
+++ b/src/xrt/drivers/rift_s/rift_s_controller.c
@@ -749,8 +749,12 @@ rift_s_controller_get_tracked_pose(struct xrt_device *xdev,
 		if (ctrl->last_tracked_pose_ts != 0) {
 			rel->pose.position = ctrl->last_tracked_pose.position;
 			rel->linear_velocity = rift_s_controller_estimate_linear_velocity(ctrl, os_monotonic_get_ns());
-			rel->relation_flags |= (enum xrt_space_relation_flags)(XRT_SPACE_RELATION_POSITION_VALID_BIT |
-			                                                       XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+			rel->relation_flags |= XRT_SPACE_RELATION_POSITION_VALID_BIT;
+			// For the constellation tracker this held position is only a search hint: not tracked,
+			// so it doesn't use it for the tight prior refinement
+			if (name != XRT_INPUT_GENERIC_TRACKER_POSE) {
+				rel->relation_flags |= XRT_SPACE_RELATION_POSITION_TRACKED_BIT;
+			}
 		}
 	}
 	os_mutex_unlock(&ctrl->mutex);
@@ -1050,6 +1054,8 @@ rift_s_controller_setup_fusion(struct rift_s_controller *ctrl)
 	u_var_add_f32(ctrl, &p->accel_noise, "Accel noise");
 	u_var_add_f32(ctrl, &p->gyro_noise, "Gyro noise");
 	u_var_add_f32(ctrl, &p->gate_chi2, "Gate chi2");
+	u_var_add_f32(ctrl, &p->reset_rot_max, "Reset max rotation off the filter (rad)");
+	u_var_add_f32(ctrl, &p->reset_trust_time, "Orientation trusted after a fix (s)");
 	u_var_add_f32(ctrl, &p->coast_start, "Coast start (s)");
 	u_var_add_f32(ctrl, &p->coast_vel_tau, "Coast velocity decay tau (s)");
 	u_var_add_f32(ctrl, &p->coast_max, "Coast max / hold after (s)");
diff --git a/src/xrt/drivers/rift_s/rift_s_controller_fusion.cpp b/src/xrt/drivers/rift_s/rift_s_controller_fusion.cpp
index a0d9af0..58dea7f 100644
--- a/src/xrt/drivers/rift_s/rift_s_controller_fusion.cpp
+++ b/src/xrt/drivers/rift_s/rift_s_controller_fusion.cpp
@@ -422,11 +422,25 @@ private:
 		if (rejected_.size() < need) {
 			return nullptr;
 		}
+		// The gyro keeps the orientation good for seconds: while it is trusted, a fix far off it is a
+		// wrong LED match, however consistent
+		const bool trusted = ns_to_s(now_ts - last_fix_ts_) < params_.reset_trust_time;
+		auto rot_ok = [&](const RejectedFix &r) {
+			return !trusted || so3_log(r.dq).norm() <= params_.reset_rot_max;
+		};
 		if (ns_to_s(now_ts - last_fix_ts_) >= params_.reset_force_after) {
-			return &rejected_.back();
+			for (auto it = rejected_.rbegin(); it != rejected_.rend(); ++it) {
+				if (rot_ok(*it)) {
+					return &*it;
+				}
+			}
+			return nullptr;
 		}
 		// Newest-first, find a fix whose offset is shared by enough others
 		for (auto it = rejected_.rbegin(); it != rejected_.rend(); ++it) {
+			if (!rot_ok(*it)) {
+				continue;
+			}
 			size_t agree = 0;
 			for (const RejectedFix &r : rejected_) {
 				if ((r.dp - it->dp).norm() <= params_.reset_consistency_pos &&
@@ -710,6 +724,8 @@ rift_s_ctrl_fusion_default_params(struct rift_s_ctrl_fusion_params *out)
 	out->reset_consistency_pos = 0.03f;
 	out->reset_consistency_rot = 0.15f;
 	out->reset_force_after = 1.5f;
+	out->reset_rot_max = 0.35f;
+	out->reset_trust_time = 2.0f;
 	out->tilt_check_max = 0.26f;
 
 	out->coast_start = 0.2f;
diff --git a/src/xrt/drivers/rift_s/rift_s_controller_fusion.h b/src/xrt/drivers/rift_s/rift_s_controller_fusion.h
index 7118add..bd4a592 100644
--- a/src/xrt/drivers/rift_s/rift_s_controller_fusion.h
+++ b/src/xrt/drivers/rift_s/rift_s_controller_fusion.h
@@ -58,6 +58,12 @@ struct rift_s_ctrl_fusion_params
 	float reset_consistency_rot;
 	//! Reset regardless of consistency once no fix was accepted for this long (s)
 	float reset_force_after;
+	//! While the filter's orientation is trusted, only reset onto fixes within this rotation of it (rad).
+	//! Wrong LED matches are often consistent with each other (e.g. a flipped ring) but far off the gyro.
+	float reset_rot_max;
+	//! The orientation is trusted for this long after the last accepted fix (s); after that the
+	//! consistency / forced resets above apply regardless of rotation, so a wrong state can't lock in
+	float reset_trust_time;
 	//! Max tilt difference between an optical pose and the accelerometer for (re)initialisation (rad)
 	float tilt_check_max;
 
diff --git a/src/xrt/include/tracking/t_constellation_tracking.h b/src/xrt/include/tracking/t_constellation_tracking.h
index bc6aeed..fb1b5b6 100644
--- a/src/xrt/include/tracking/t_constellation_tracking.h
+++ b/src/xrt/include/tracking/t_constellation_tracking.h
