From 2743ef333045e1395d99354894ac3a943e47ca70 Mon Sep 17 00:00:00 2001
From: lbgos <285507185+lbgos@users.noreply.github.com>
Date: Tue, 13 Oct 2026 00:01:30 +0300
Subject: [PATCH 35/46] constellation: reject device adds past
 CONSTELLATION_MAX_DEVICES

t_constellation_tracker_add_device() guarded the devices[] write with
assert() only, so a release build adding a fifth device would
overflow the array. Return NULL when full instead.

(cherry picked from commit f2a08eaf4c6f0bfcd986c53022cce91334cf3929)
---
 src/xrt/tracking/constellation/t_constellation_tracking.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/xrt/tracking/constellation/t_constellation_tracking.c b/src/xrt/tracking/constellation/t_constellation_tracking.c
index 3fde3ba..c5e1fd5 100644
--- a/src/xrt/tracking/constellation/t_constellation_tracking.c
+++ b/src/xrt/tracking/constellation/t_constellation_tracking.c
@@ -1505,6 +1505,11 @@ t_constellation_tracker_add_device(struct t_constellation_tracker *ct,
                                    struct t_constellation_tracked_device_callbacks *cb)
 {
 	os_mutex_lock(&ct->tracked_device_lock);
+	if (ct->num_devices >= CONSTELLATION_MAX_DEVICES) {
+		CT_ERROR(ct, "Constellation tracker: device limit (%d) reached, rejecting add", CONSTELLATION_MAX_DEVICES);
+		os_mutex_unlock(&ct->tracked_device_lock);
+		return NULL;
+	}
 	assert(ct->num_devices < CONSTELLATION_MAX_DEVICES);
 
 	CT_DEBUG(ct, "Constellation tracker: Adding device %d", ct->num_devices);
-- 
